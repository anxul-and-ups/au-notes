{
  "systemSetup": [
    {
      "name": "Install JDK 17",
      "command": "curl -fsSL https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.13%2B11/OpenJDK17U-jdk_x64_linux_hotspot_17.0.13_11.tar.gz -o /tmp/jdk17.tar.gz && mkdir -p $HOME/jdk17 && tar -xzf /tmp/jdk17.tar.gz -C $HOME/jdk17 --strip-components=1 && rm /tmp/jdk17.tar.gz && $HOME/jdk17/bin/java -version"
    },
    {
      "name": "Install Android SDK",
      "command": "export JAVA_HOME=$HOME/jdk17 && export PATH=$JAVA_HOME/bin:$PATH && mkdir -p $HOME/android-sdk/cmdline-tools && curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/cmdline-tools.zip && mkdir -p /tmp/cmdline-tools-tmp && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools-tmp && mkdir -p $HOME/android-sdk/cmdline-tools/latest && mv /tmp/cmdline-tools-tmp/cmdline-tools/* $HOME/android-sdk/cmdline-tools/latest/ && rm -rf /tmp/cmdline-tools.zip /tmp/cmdline-tools-tmp && yes | $HOME/android-sdk/cmdline-tools/latest/bin/sdkmanager --licenses && $HOME/android-sdk/cmdline-tools/latest/bin/sdkmanager \"platform-tools\" \"platforms;android-36\" \"build-tools;36.0.0\" \"platforms;android-36.1\""
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Configure SDK Path",
      "command": "echo \"sdk.dir=$HOME/android-sdk\" > local.properties && cat local.properties"
    },
    {
      "name": "Configure Env Files",
      "command": "cp -n .env .env.example 2>/dev/null || true && ls -la .env*"
    },
    {
      "name": "Install Dependencies",
      "command": "export JAVA_HOME=$HOME/jdk17 && export PATH=$JAVA_HOME/bin:$PATH && export ANDROID_HOME=$HOME/android-sdk && chmod +x gradlew && ./gradlew --version"
    }
  ],
  "codeChecks": [
    {
      "name": "Run Lint",
      "command": "export JAVA_HOME=$HOME/jdk17 && export PATH=$JAVA_HOME/bin:$PATH && export ANDROID_HOME=$HOME/android-sdk && ./gradlew lintDebug"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Debug APK",
      "command": "export JAVA_HOME=$HOME/jdk17 && export PATH=$JAVA_HOME/bin:$PATH && export ANDROID_HOME=$HOME/android-sdk && ./gradlew assembleDebug"
    }
  ],
  "runStep": [
    {
      "name": "Serve APK",
      "command": "python3 -m http.server 4000 --bind 0.0.0.0 --directory app/build/outputs/apk/debug",
      "port": "4000"
    }
  ],
  "deploySteps": [
    {
      "name": "Build Release APK",
      "command": "export JAVA_HOME=$HOME/jdk17 && export PATH=$JAVA_HOME/bin:$PATH && export ANDROID_HOME=$HOME/android-sdk && ./gradlew assembleRelease"
    }
  ],
  "cleanupFiles": [
    "app/build/",
    ".gradle/",
    "build/",
    ".kotlin/",
    ".build-outputs",
    "local.properties"
  ],
  "packageManager": "gradle",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
